# ---- Required on Railway ----
# Railway fills this in when you add the Postgres plugin and reference it: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safari
NODE_ENV=production

# First owner login. Used once, only when no admin exists. Remove ADMIN_PASSWORD after the first deploy.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
ADMIN_NAME=Owner

# ---- Email (Google Apps Script relay, see docs/APPS_SCRIPT.md) ----
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
APPS_SCRIPT_SECRET=same-value-as-RELAY_SECRET-in-the-script

# ---- Payments (set what you use; PAYMENT_PROVIDERS picks and orders them) ----
# PAYMENT_PROVIDERS=onepay,stripe      (use "mock" to try the flow with no real money)
ONEPAY_APP_ID=
ONEPAY_APP_TOKEN=
ONEPAY_HASH_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# ---- Optional ----
# APP_URL=https://book.yourdomain.lk     (defaults to the Railway domain)
# TICKET_SECRET=                          (auto-generated and stored in the database if empty)
# SEED_DEMO=1                             (adds sample partners/bookings on an empty database)
